{
  "user_name": "",
  "personality": "You are Jarvis, a witty, loyal and efficient personal assistant running locally on the user's Windows laptop. You can open and close apps, open websites, search the web, check the time and battery, and remember facts the user tells you.",
  "greeting": "Jarvis online. How can I help?",
  "farewell": "Shutting down. Goodbye.",

  "model_plugged_in": "llama3.2:3b",
  "model_on_battery": "llama3.2:1b",
  "context_size": 2048,
  "keep_alive": "30m",
  "history_turns": 6,
  "temperature": 0.6,
  "max_tool_rounds": 3,

  "wake_word": "hey_jarvis",
  "wake_threshold": 0.5,
  "whisper_model": "small",
  "languages": ["en", "ro"],

  "silence_level": 500,
  "silence_seconds": 1.5,
  "no_speech_seconds": 6.0,
  "follow_up_seconds": 8.0,
  "max_command_seconds": 20,
  "wake_beep": { "hz": 880, "ms": 120 },
  "sleep_beep": { "hz": 440, "ms": 120 },
  "beep_grace_seconds": 0.3,
  "sleep_phrases": [
    "that's all", "that is all", "stop listening", "go to sleep", "goodbye", "never mind",
    "asta e tot", "asta a fost tot", "nu mai asculta", "du-te la culcare", "la revedere", "nu contează"
  ],
  "shutdown_phrases": [
    "shut down", "shutdown", "power off", "power down", "go offline", "turn yourself off",
    "exit jarvis", "quit jarvis", "oprește-te", "închide-te", "oprește jarvis", "închide jarvis"
  ],

  "piper_voices": ["en_US-lessac-medium", "ro_RO-mihai-medium"],

  "memory_file": "data/memory.json",
  "log_dir": "logs",
  "ui_config": "config/ui.json",

  "sites": {
    "gmail": "mail.google.com",
    "youtube": "youtube.com"
  },

  "contacts": {},

  "browsers": {
    "firefox": { "command": "firefox", "args": ["-new-tab"], "new_tab": "about:newtab" },
    "chrome":  { "command": "chrome", "args": ["-new-tab"], "new_tab": "chrome://newtab" },
    "edge":    { "command": "msedge", "args": ["-new-tab"], "new_tab": "edge://newtab" }
  },

  "action_words": [
    "open", "launch", "start", "close", "quit", "search", "google", "look up", "find out", "time", "date",
    "battery", "remember", "website", "tab", "browser", "price", "stock", "shares", "weather",
    "news", "latest", "current", "score", "who won", "compose", "mail", "send",
    "deschide", "pornește", "lansează", "închide", "caută", "găsește", "află", "ora", "ceas", "data",
    "baterie", "bateria", "ține minte", "memorează", "reține", "site", "filă", "preț", "acțiuni",
    "bursă", "vreme", "temperatura", "știri", "noutăți", "ultimele", "scor", "meci", "cine a câștigat",
    "trimite", "scrie"
  ]
}
